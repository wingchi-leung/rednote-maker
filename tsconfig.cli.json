{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "./dist",
    "noEmit": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/lib/**/*.ts",
    "src/store/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
